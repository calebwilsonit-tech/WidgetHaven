{
  "name": "haven",
  "productName": "Haven",
  "version": "1.6.0",
  "description": "A beautiful desktop organizer for your apps, games, files, folders and links.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "icon": "node tools/make-icon.js",
    "dist": "electron-builder --win nsis portable --publish never",
    "dist:setup": "electron-builder --win nsis --publish never",
    "release:patch": "npm version patch && npm run dist",
    "release:minor": "npm version minor && npm run dist"
  },
  "author": "Haven",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/calebwilsonit-tech/WidgetHaven.git"
  },
  "homepage": "https://github.com/calebwilsonit-tech/WidgetHaven",
  "bugs": {
    "url": "https://github.com/calebwilsonit-tech/WidgetHaven/issues"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "koffi": "^3.3.8"
  },
  "build": {
    "appId": "app.haven.organizer",
    "productName": "Haven",
    "copyright": "Haven",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "src/icons.ps1",
      "src/native/**",
      "node_modules/koffi/**",
      "node_modules/@koromix/**"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Haven",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Haven-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Haven-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "calebwilsonit-tech",
        "repo": "WidgetHaven"
      }
    ]
  }
}
